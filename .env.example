# Password for /admin/beta (required to view beta signups)
BETA_ADMIN_SECRET=choose-a-strong-password-here

# Required on Vercel for persistent beta signups
# Vercel Dashboard → Storage → Redis (Upstash) → Connect to project
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: webhook URL for instant signup alerts (Discord, Slack, Zapier, Google Apps Script)
# BETA_NOTIFY_WEBHOOK=https://your-webhook-url
